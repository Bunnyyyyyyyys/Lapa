        <mxCell id="6q69dES9uQ2kKF0_WAWo-6" value="&lt;font&gt;|&lt;/font&gt;&lt;div&gt;&lt;font&gt;|---Если достаточно средств&lt;/font&gt;&lt;div&gt;&lt;font&gt;|&lt;/font&gt;&lt;br&gt;&lt;div&gt;&lt;font&gt;&lt;font&gt;&lt;font&gt;V&lt;/font&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;font&gt;&lt;span style=&quot;&quot;&gt;[Транзакция: списание предоплаты с баланса]&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt; |&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt; V&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt;[Создание заявки в &quot;petRequests&quot; и обновление статуса питомца]&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt; |&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt; V&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt;[Сохранение питомца в SharedPreferences (my_pets)]&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt; |&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt; V&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt;[Переход в MainActivity с открытым фрагментом &quot;Мои питомцы&quot;]&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;span style=&quot;&quot;&gt;ИЛИ&lt;/span&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt;&lt;font&gt; |&lt;/font&gt;&lt;br style=&quot;padding: 0px; margin: 0px;&quot;&gt; &lt;/font&gt;&lt;/font&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rg